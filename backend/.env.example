# CodeSync Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/codesync"

# ── JWT Secrets (use long random strings in production) ───────────────────────
JWT_ACCESS_SECRET=your-access-secret-change-this
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL (for CORS + OAuth redirect) ──────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Email (Nodemailer SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CodeSync <no-reply@codesync.dev>

# ── Code Execution Engine ─────────────────────────────────────────────────────
# USE_PISTON=true  → Piston API (safe, sandboxed Docker, 50+ languages) [RECOMMENDED]
# USE_PISTON=false → Local child_process (unsafe, offline fallback, JS+Python only)
USE_PISTON=true

# Optional: self-hosted Piston instance
# PISTON_API_URL=http://localhost:2000/api/v2

# ── File Storage ──────────────────────────────────────────────────────────────
# USE_S3=false → File content stored in PostgreSQL TEXT column (default, no setup needed)
# USE_S3=true  → File content stored in AWS S3 (requires AWS credentials below)
USE_S3=false

# Required only if USE_S3=true — also run: npm install @aws-sdk/client-s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=codesync-files
